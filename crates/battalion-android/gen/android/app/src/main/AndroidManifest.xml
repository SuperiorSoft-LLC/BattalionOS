<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AND-4: an app's notices (os_notify, permission `notifications` in its app.json); asked at the first notice. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AND-4: os_open_external asks Android which app opens a link (package visibility, API 30+). -->
    <queries>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="http" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="mailto" /></intent>
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.battalion_android"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- AND-4: os_scan_code uses the Google code scanner (no camera permission for BattalionOS); its module is fetched at install. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- AND-3: app slot 0: one app's page in its own process (created and ended by the OS's hub, SlotHub.kt). -->
        <activity
            android:name=".AppSlot0"
            android:process=":app0"
            android:taskAffinity="${applicationId}.app0"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.battalion_android"
            android:exported="false" />
        <!-- AND-3: app slot 1: one app's page in its own process (created and ended by the OS's hub, SlotHub.kt). -->
        <activity
            android:name=".AppSlot1"
            android:process=":app1"
            android:taskAffinity="${applicationId}.app1"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.battalion_android"
            android:exported="false" />
        <!-- AND-3: app slot 2: one app's page in its own process (created and ended by the OS's hub, SlotHub.kt). -->
        <activity
            android:name=".AppSlot2"
            android:process=":app2"
            android:taskAffinity="${applicationId}.app2"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.battalion_android"
            android:exported="false" />
        <!-- AND-3: app slot 3: one app's page in its own process (created and ended by the OS's hub, SlotHub.kt). -->
        <activity
            android:name=".AppSlot3"
            android:process=":app3"
            android:taskAffinity="${applicationId}.app3"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.battalion_android"
            android:exported="false" />
        <service android:name=".SlotHubService" android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
