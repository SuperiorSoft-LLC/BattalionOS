{
  "manifest": 1,
  "id": "demo-app",
  "name": "Demo App",
  "version": "1.0.0",
  "publisher": "BattalionOS",
  "license": "Apache-2.0",
  "contract": { "min": 1, "max": 1 },
  "minOs": "0.1.0",
  "process": {
    "windows-x86_64": { "library": "lib/demo_app.dll", "args": [], "env": {}, "readyTimeoutMs": 10000, "stopTimeoutMs": 3000 },
    "linux-x86_64": { "library": "lib/libdemo_app.so", "args": [], "env": {}, "readyTimeoutMs": 10000, "stopTimeoutMs": 3000 },
    "macos-aarch64": { "library": "lib/libdemo_app.dylib", "args": [], "env": {}, "readyTimeoutMs": 10000, "stopTimeoutMs": 3000 }
  },
  "init": { "exec": "bin/demo-helper", "args": ["--init"] },
  "ui": { "entry": "ui/index.html", "window": { "width": 900, "height": 600 } },
  "state": { "schema": 1 },
  "permissions": ["window"]
}
